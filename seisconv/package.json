{
  "name": "seisconv",
  "version": "0.1.0",
  "description": "SeisConv — desktop seismic data converter & toolkit (a branch of SmartSeismicSystem)",
  "author": "Moshe Fridin",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build:main": "esbuild electron/main.ts --bundle --platform=node --target=node20 --external:electron --outfile=dist/main.js --format=cjs",
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --target=node20 --external:electron --outfile=dist/preload.js --format=cjs",
    "build:worker": "esbuild workers/parse.worker.ts --bundle --platform=node --target=node20 --outfile=dist/parse.worker.js --format=cjs",
    "build": "npm run build:main && npm run build:preload && npm run build:worker",
    "start": "npm run build && electron .",
    "test:core": "tsx core/__tests__/run.ts",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.smartseismic.seisconv",
    "productName": "SeisConv",
    "files": ["dist/**", "renderer/**", "package.json"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
